{
  "name": "threads-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "build:client": "vite build",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker",
    "build": "npm run typecheck && npm run build:client",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply threads-lab-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply threads-lab-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wrangler": "^4.16.1"
  }
}
